# Server
PORT=5000
NODE_ENV=development
JWT_SECRET=your-jwt-secret-change-in-production
JWT_EXPIRES_IN=7d

# Database (set USE_POSTGRES=true to use real PostgreSQL)
USE_POSTGRES=false
DATABASE_URL=postgresql://user:password@localhost:5432/kisandirect

# AI Service
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_ENABLED=true

# Frontend
VITE_API_URL=http://localhost:5000/api
